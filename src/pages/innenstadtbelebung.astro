---
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';
import Placeholder from '../components/Placeholder.astro';
import Photo from '../components/Photo.astro';
import LogoBand from '../components/LogoBand.astro';

import imgFussgaengerzone from '../assets/innenstadtbelebung/gestaltungssatzung.jpg';
import imgMoeblierung from '../assets/innenstadtbelebung/moeblierung-begruenung.jpg';
import imgPodeste from '../assets/innenstadtbelebung/platzgestaltung-alt.jpg';
import imgEinkaufsstrasse from '../assets/innenstadtbelebung/gestaltungssatzung-alt.jpg';
import imgBesucherlenkung from '../assets/innenstadtbelebung/besucherlenkung.jpg';
import imgPlatz from '../assets/innenstadtbelebung/platzgestaltung.jpg';
import imgHaltestelle from '../assets/innenstadtbelebung/aufwertung-haltestelle.jpg';
import imgDigital from '../assets/innenstadtbelebung/digitale-medien.jpg';
import imgWorkshop from '../assets/innenstadtbelebung/beteiligung-workshop.jpg';


const handlungsfelder = [
  { t: 'Erlebnisort Innenstadt', d: 'Handel, Gastronomie, Kultur und Freizeit zu einem Stadterlebnis verbinden, das Menschen gerne besuchen.' },
  { t: 'Aufenthaltsqualität & Stadtmöblierung', d: 'Einheitliche Möblierung, Begrünung, Wasser und Schatten, Kunst im öffentlichen Raum und temporäre Aktionen, die Plätze beleben.' },
  { t: 'Besucherlenkung & Orientierung', d: 'Fußgänger- und touristische Leitsysteme, barrierefreie Information und die Verbindung von analoger und digitaler Orientierung – z. B. vom Bahnhof, Parkhaus oder ÖPNV in die Innenstadt.' },
  { t: 'Stadtmarketing & Profil', d: 'Ein klares Profil und eine starke Stadtmarke, die Bürgerinnen, Bürger und Gäste emotional an die Innenstadt binden – entwickelt gemeinsam mit den Beteiligten vor Ort.' },
  { t: 'Räume neu denken', d: 'Leerstände systematisch erfassen und visualisieren (GIS-basiert), neue Nutzungen für Kultur, Freizeit und Begegnung entwickeln.' },
];

const massnahmen = [
  { t: 'Besucherlenkung & Fußgängerleitung', d: 'Wege, die zu Entdeckungen werden.', img: imgBesucherlenkung, alt: 'Moderner Fußgänger-Wegweiser und Info-Stele in der Innenstadt' },
  { t: 'Platzgestaltung & Installationen', d: 'Plätze temporär oder dauerhaft aktivieren.', img: imgPlatz, alt: 'Temporäre Platzgestaltung mit Sitzpodesten und Sonnensegeln' },
  { t: 'Aufwertung & Attraktivierung', d: 'Sichtbare Qualität, z. B. Haltestellen, Fassaden, Eingänge.', img: imgHaltestelle, alt: 'Haltestelle mit farbiger Willkommens-Banderole im Stadtdesign' },
  { t: 'Digitale Medien & Info-Apps', d: 'Orientierung und Information auf dem Smartphone.', img: imgDigital, alt: 'Smartphone mit digitaler Stadtkarte und Fußweg-Route' },
];

const formate = ['Workshops und Roundtables', 'Bürgerbefragungen und Beteiligungskonzepte', 'Expertengespräche und Stakeholder-Einbindung', 'Informationsveranstaltungen', 'Prozessbegleitung für die Verwaltung', 'Kommunikations- und Stadtmarketingkonzepte'];

const projekte = [
  { t: 'Vom Bahnhof in die Innenstadt', tag: 'Besucherlenkung', ort: 'Ellwangen', alt: 'Foto folgt: Wegweisung vom Bahnhof in die Innenstadt Ellwangen' },
  { t: 'Begrünte Stadtmöblierung für mehr Aufenthaltsqualität', tag: 'Aufenthaltsqualität', ort: null, alt: 'Foto folgt: Begrünte Stadtmöblierung („Aufs richtige Pferd gesetzt“)' },
  { t: 'Altstadtflair bewahren', tag: 'Werbeanlagensatzung', ort: 'Heidelberg', alt: 'Foto folgt: Altstadtgasse in Heidelberg mit einheitlichen Werbeanlagen' },
  { t: 'Dem Geißbock auf der Spur', tag: 'Barrierefreies touristisches Leitsystem', ort: 'Deidesheim', alt: 'Foto folgt: Barrierefreies Leitsystem in Deidesheim' },
];

const stimmen = [
  { q: 'Die Zusammenarbeit mit city concepts war sehr gut und hat hervorragende Ergebnisse gebracht.', wer: 'Verena Kiedaisch', rolle: 'City-Managerin und Wirtschaftsbeauftragte, Stadt Ellwangen' },
  { q: '[…] Ihr Umgang mit den Herausforderungen einer barrierefreien Gestaltung in einem denkmalgeschützten Bereich war beispielhaft. […]', wer: 'Manfred Dörr', rolle: 'Stadtbürgermeister, Deidesheim' },
];

const argumente = [
  { t: 'Herstellerneutral', d: 'Wir planen und beraten unabhängig. Wir verkaufen keine Schilder und keine Möbel, sondern die passende Lösung.' },
  { t: 'Wir sprechen „kommunal“', d: 'Wir kennen Abläufe, Gremien, Fördermittel und Vergaberecht und begleiten die Verwaltung durch den gesamten Prozess.' },
  { t: 'Ganzheitlich', d: 'Von Orientierung über Aufenthaltsqualität bis Stadtmarketing: alles aus einer Hand, aufeinander abgestimmt.' },
];

const ablauf = [
  { t: 'Bestandsaufnahme', d: 'Vor-Ort-Begehung, Analyse von Wegen, Plätzen, Angeboten und Leerständen.' },
  { t: 'Beteiligung', d: 'Gespräche mit Verwaltung, Handel, Gastronomie, Bürgerinnen und Bürgern.' },
  { t: 'Konzept & Maßnahmenplan', d: 'Priorisierte Maßnahmen mit Kostenrahmen und Hinweisen zu Fördermöglichkeiten.' },
  { t: 'Umsetzung & Vergabe', d: 'Ausführungsplanung, Begleitung des Vergabeverfahrens und der Realisierung.' },
];

const faq = [
  { q: 'Lohnt sich das auch für kleinere Gemeinden?', a: 'Ja. Viele Maßnahmen sind skalierbar – von einzelnen Plätzen und Wegen bis zum gesamten Innenstadtkonzept.' },
  { q: 'Gibt es Fördermittel?', a: 'Häufig ja. Neben der Städtebauförderung gibt es Landesprogramme, z. B. „Innenstadt-Impulse“ (Rheinland-Pfalz) oder „Zukunft Innenstadt“ (Hessen). Wir zeigen auf, welche Maßnahmen förderfähig sein können.', todo: 'Programme vor Veröffentlichung prüfen, BW ergänzen' },
  { q: 'Begleitet ihr auch die Ausschreibung?', a: 'Ja. Wir erstellen Ausführungsplanung und Leistungsverzeichnisse und begleiten das Vergabeverfahren.' },
  { q: 'Wie werden Bürger und Handel eingebunden?', a: 'Über Workshops, Befragungen, Roundtables und Expertengespräche – je nach Projekt und Budget.' },
  { q: 'Wie lange dauert ein Projekt?', todo: 'Spannen nennen, z. B. Konzept 3–6 Monate' },
  { q: 'Was kostet ein Innenstadtkonzept?', todo: 'Entscheidung: „ab“-Preis oder nur auf Anfrage' },
  { q: 'Seid ihr Hersteller von Leitsystemen oder Möbeln?', a: 'Nein. Wir planen herstellerneutral und begleiten die Vergabe an ausführende Firmen.' },
];

const anliegen = ['Innenstadtkonzept', 'Aufenthaltsqualität & Möblierung', 'Besucherlenkung', 'Stadtmarketing & Beteiligung', 'Noch offen'];
const nav = [['Handlungsfelder', '#handlungsfelder'], ['Projekte', '#projekte'], ['Ablauf', '#ablauf'], ['FAQ', '#faq']];
---
<Base
  title="Innenstadtbelebung & Innenstadtentwicklung | city concepts"
  description="Konkrete Maßnahmen für eine lebendige Innenstadt: Analyse, Beteiligung, Konzept und Umsetzung – herstellerneutral und förderkundig. Jetzt Erstgespräch anfragen."
>
  <header class="site-header">
    <div class="container site-header__in">
      <a href="/innenstadtbelebung/" class="site-header__logo" aria-label="city concepts – Startseite dieser Seite"><Wordmark /></a>
      <nav class="site-header__nav" aria-label="Seitenbereiche">
        <ul>{nav.map(([l, h]) => <li><a href={h}>{l}</a></li>)}</ul>
      </nav>
      <div class="site-header__end">
        <a class="site-header__tel" href="tel:+496221759080" data-track-pos="header">06221 75908-0</a>
        <a class="btn btn--petrol site-header__cta" href="#kontakt" data-track-pos="header">Erstgespräch anfragen</a>
      </div>
    </div>
  </header>

  <main id="inhalt">
    <div class="wash">
      <!-- 2 Hero -->
      <section class="hero" aria-labelledby="h1">
        <div class="container hero__in">
          <div class="hero__text">
            <p class="eyebrow">Innenstadtentwicklung für Städte und Gemeinden</p>
            <h1 id="h1" class="h1">Innenstädte, in denen man <span class="mark">gerne bleibt.</span></h1>
            <p class="lead hero__sub">Konkrete Handlungsempfehlungen und Maßnahmen für die Aufwertung und Belebung Ihrer Innenstadt – von der Analyse bis zur Umsetzung.</p>
            <div class="hero__cta">
              <a class="btn btn--primary" href="#kontakt" data-track-pos="hero">Erstgespräch anfragen</a>
              <a class="btn btn--ink" href="#handlungsfelder" data-track-pos="hero-handlungsfelder">Handlungsfelder ansehen</a>
            </div>
            <p class="hero__tel small">oder direkt anrufen: <a href="tel:+496221759080" data-track-pos="hero">06221 75908-0</a></p>
          </div>

          <div class="collage">
            <Photo class="collage__main" src={imgFussgaengerzone} eager sizes="(min-width: 62rem) 40vw, 92vw" alt="Belebte Fußgängerzone einer Innenstadt mit Cafés und Passanten" />
            <Photo class="collage__left" src={imgMoeblierung} eager sizes="(min-width: 62rem) 20vw, 46vw" alt="Holzpodest mit Pflanzinseln, auf dem Menschen sitzen" />
            <Photo class="collage__right" src={imgPodeste} eager sizes="(min-width: 62rem) 18vw, 46vw" alt="Platz mit bunten Sitzpodesten und Sonnensegeln" />
            <p class="badge badge--a"><strong><span class="todo">20+</span></strong>Jahre für Städte und Kommunen</p>
            <p class="badge badge--b"><strong><span class="todo">120</span></strong>begleitete Vergabeverfahren</p>
          </div>
        </div>
      </section>

      <!-- 3 Logo-Leiste -->
      <section class="logos" aria-labelledby="logos-h">
        <div class="container logos__in">
          <h2 id="logos-h" class="logos__label">Kommunen, für die wir bereits tätig sein durften</h2>
          <LogoBand />
        </div>
      </section>

      <!-- 4 Handlungsfelder -->
      <section id="handlungsfelder" class="hf" aria-labelledby="hf-h">
        <div class="container hf__in">
          <div class="panel on-dark hf__panel reveal">
            <Photo class="hf__img" src={imgEinkaufsstrasse} sizes="(min-width: 62rem) 40vw, 92vw" alt="Gepflegte Einkaufsstraße mit Blumenschmuck und Außengastronomie" />
            <p class="hf__statement">Die Zukunft der Innenstadt entscheidet sich nicht mehr allein über den Handel.</p>
            <p class="hf__statement-sub">Lebendige Innenstädte verbinden Handel, Gastronomie, Kultur, Tourismus, Aufenthaltsqualität und Orientierung zu einem Gesamterlebnis. Genau dort setzen wir an.</p>
          </div>
          <div class="hf__list reveal">
            <p class="eyebrow">Handlungsfelder</p>
            <h2 id="hf-h" class="title">Fünf Hebel für eine lebendige Innenstadt.</h2>
            <ol class="rows">
              {handlungsfelder.map((h, i) => (
                <li class="rows__item">
                  <span class="num">{String(i + 1).padStart(2, '0')}</span>
                  <div><h3 class="h3">{h.t}</h3><p>{h.d}</p></div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>
    </div>

    <!-- 5 Maßnahmen -->
    <section id="massnahmen" class="mass" aria-labelledby="mass-h">
      <div class="container">
        <div class="mass__head reveal">
          <div>
            <p class="eyebrow">Maßnahmen</p>
            <h2 id="mass-h" class="title">Vom Konzept zur sichtbaren Veränderung.</h2>
          </div>
          <p class="lead">city concepts übersetzt die Handlungsfelder in konkrete Maßnahmen – passend zu Größe, Budget und Ausgangslage Ihrer Kommune.</p>
        </div>
        <ol class="mass__cards">
          {massnahmen.map((m, i) => (
            <li class="mcard reveal" style={`--d:${i * 80}ms`}>
              <div class="mcard__media">
                <Photo class="mcard__photo" src={m.img} ratio="4 / 3" sizes="(min-width: 62rem) 24vw, (min-width: 40rem) 45vw, 92vw" alt={m.alt} />
                <span class="chip-num" aria-label={`Maßnahme ${i + 1}`}>{String(i + 1).padStart(2, '0')}</span>
              </div>
              <div class="mcard__body">
                <h3 class="h3">{m.t}</h3>
                <p>{m.d}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="mid-cta reveal">
          <p class="mid-cta__text">Welche Maßnahmen passen zu Ihrer Innenstadt? Wir besprechen es mit Ihnen im Erstgespräch.</p>
          <a class="btn btn--primary" href="#kontakt" data-track-pos="zwischen-cta-1">Erstgespräch anfragen</a>
        </div>
      </div>
    </section>

    <!-- 6 Beteiligung & Kennzahlen -->
    <section class="bet" aria-labelledby="bet-h">
      <div class="container">
        <div class="panel on-dark bet__panel reveal">
          <div class="bet__media">
            <Photo class="bet__img" src={imgWorkshop} sizes="(min-width: 62rem) 40vw, 92vw" alt="Workshop zur Bürgerbeteiligung mit Stadtplan und Klebezetteln" />
            <p class="badge badge--c"><strong><span class="todo">30+</span></strong>Kommunen betreut</p>
          </div>
          <div class="bet__text">
            <p class="eyebrow">Kommunikation &amp; Beteiligung</p>
            <h2 id="bet-h" class="title">Innenstadt entsteht gemeinsam.</h2>
            <p class="lead">Workshops, Bürgerbefragungen und Roundtables mit Verwaltung, Handel und Bürgerschaft – damit Maßnahmen getragen werden.</p>
            <ul class="list-square bet__list">{formate.map((f) => <li>{f}</li>)}</ul>
            <a class="btn btn--primary" href="#kontakt" data-track-pos="beteiligung">Erstgespräch anfragen</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 7 Projekte -->
    <section id="projekte" class="proj" aria-labelledby="proj-h">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Projekte</p>
          <h2 id="proj-h" class="title">Eine Auswahl unserer Projekte.</h2>
        </div>
        <ul class="proj__grid">
          {projekte.map((p, i) => (
            <li class="pcard reveal" style={`--d:${i * 70}ms`}>
              <Placeholder ratio="4 / 3" alt={p.alt} />
              <div class="pcard__body">
                <p class="pcard__meta"><span class="pcard__tag">{p.tag}</span><span class="pcard__ort">{p.ort ?? <span class="todo">Ort</span>}</span></p>
                <h3 class="h3">{p.t}</h3>
              </div>
            </li>
          ))}
        </ul>
        <div class="quotes">
          {stimmen.map((s) => (
            <figure class="quote reveal">
              <blockquote><p>{s.q}</p></blockquote>
              <figcaption><strong>{s.wer}</strong>, {s.rolle}</figcaption>
            </figure>
          ))}
        </div>
        <p class="small muted quotes__note"><span class="todo">Freigabe der Kundenstimmen für das Web klären</span></p>
        <div class="mid-cta reveal">
          <p class="mid-cta__text">Ihre Innenstadt als nächstes Projekt? Sprechen Sie mit uns über Ihre Ausgangslage.</p>
          <a class="btn btn--primary" href="#kontakt" data-track-pos="zwischen-cta-2">Erstgespräch anfragen</a>
        </div>
      </div>
    </section>

    <!-- 8 Warum + Ablauf -->
    <section class="warum" aria-labelledby="warum-h">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Warum city concepts</p>
          <h2 id="warum-h" class="title">Warum Kommunen mit uns arbeiten.</h2>
        </div>
        <ul class="args">
          {argumente.map((a, i) => (
            <li class="args__item reveal" style={`--d:${i * 80}ms`}>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="h3">{a.t}</h3>
              <p>{a.d}</p>
            </li>
          ))}
        </ul>

        <div id="ablauf" class="ablauf">
          <div class="section-head reveal">
            <p class="eyebrow">Ablauf</p>
            <h3 class="title">So arbeiten wir mit Ihnen. <span class="todo">bestätigen</span></h3>
          </div>
          <ol class="steps">
            {ablauf.map((s, i) => (
              <li class="steps__item reveal" style={`--d:${i * 80}ms`}>
                <span class="steps__no" aria-hidden="true">{i + 1}</span>
                <h4 class="h4">{s.t}</h4>
                <p>{s.d}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- 9 FAQ -->
    <section id="faq" class="faq" aria-labelledby="faq-h">
      <div class="container faq__in">
        <div class="reveal">
          <p class="eyebrow">FAQ</p>
          <h2 id="faq-h" class="title">Häufige Fragen.</h2>
        </div>
        <div class="faq__list reveal">
          {faq.map((f) => (
            <details class="qa">
              <summary><span>{f.q}</span><span class="qa__icon" aria-hidden="true"></span></summary>
              <div class="qa__a">
                {f.a && <p>{f.a}</p>}
                {f.todo && <p><span class="todo">{f.todo}</span></p>}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 10 Kontakt -->
    <section id="kontakt" class="kontakt" aria-labelledby="kontakt-h">
      <div class="container">
        <div class="panel on-dark contact">
          <div class="contact__intro">
            <p class="eyebrow">Kontakt</p>
            <h2 id="kontakt-h" class="title">Lassen Sie uns über Ihre Innenstadt sprechen.</h2>
            <p class="lead">Erzählen Sie uns von Ihrer Ausgangslage – wir melden uns innerhalb von <span class="todo">2 Werktagen</span> mit einem Vorschlag für ein Erstgespräch.</p>
            <div class="person">
              <Placeholder class="person__img" ratio="1 / 1" alt="Foto Ansprechpartner:in" />
              <p><span class="todo">Name, Funktion</span><br />city concepts · Hans-Bunte-Straße 20 · 69123 Heidelberg<br /><a href="tel:+496221759080" data-track-pos="kontakt">06221 75908-0</a><br /><a href="mailto:info@city-concepts.de" data-track-pos="kontakt">info@city-concepts.de</a></p>
            </div>
          </div>

          <form id="kontakt-form" class="form" action="/danke/" method="post" novalidate>
            <input type="hidden" name="utm_source" /><input type="hidden" name="utm_medium" /><input type="hidden" name="utm_campaign" /><input type="hidden" name="gclid" />
            <p class="form__step" id="step-label" aria-live="polite">Schritt 1 von 2</p>

            <fieldset id="step-1">
              <legend class="h4">Ihr Anliegen <span class="small">(Mehrfachauswahl möglich)</span></legend>
              <div class="chips">
                {anliegen.map((a) => (
                  <label class="chip"><input type="checkbox" name="anliegen" value={a} /><span>{a}</span></label>
                ))}
              </div>
              <button type="button" class="btn btn--primary" id="next">Weiter</button>
            </fieldset>

            <fieldset id="step-2" hidden>
              <legend class="h4">Ihre Angaben</legend>
              <div class="field"><label for="f-kommune">Kommune <span aria-hidden="true">*</span></label><input id="f-kommune" name="kommune" required autocomplete="organization" /></div>
              <div class="field"><label for="f-name">Name <span aria-hidden="true">*</span></label><input id="f-name" name="name" required autocomplete="name" /></div>
              <div class="field"><label for="f-funktion">Funktion</label><input id="f-funktion" name="funktion" autocomplete="organization-title" /></div>
              <div class="field"><label for="f-mail">E-Mail <span aria-hidden="true">*</span></label><input id="f-mail" name="email" type="email" required autocomplete="email" /></div>
              <div class="field"><label for="f-tel">Telefon</label><input id="f-tel" name="telefon" type="tel" autocomplete="tel" /></div>
              <div class="field"><label for="f-msg">Nachricht</label><textarea id="f-msg" name="nachricht" rows="4"></textarea></div>
              <div class="field field--check">
                <input id="f-dsgvo" name="datenschutz" type="checkbox" required />
                <label for="f-dsgvo">Ich habe die <a href="/datenschutz/">Datenschutzerklärung</a> gelesen und bin mit der Verarbeitung meiner Angaben zur Bearbeitung der Anfrage einverstanden. <span aria-hidden="true">*</span></label>
              </div>
              <p class="small">* Pflichtfelder</p>
              <div class="form__actions">
                <button type="button" class="btn btn--white" id="back">Zurück</button>
                <button type="submit" class="btn btn--primary">Anfrage senden</button>
              </div>
            </fieldset>
            <div class="form__errors" id="form-errors" role="alert" tabindex="-1" hidden></div>
          </form>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer on-dark">
    <div class="container site-footer__in">
      <div>
        <Wordmark variant="light" />
        <p class="small">city concepts – ein Unternehmen der unity concepts GmbH<br />Hans-Bunte-Straße 20 · 69123 Heidelberg</p>
        <p class="small"><a href="tel:+496221759080" data-track-pos="footer">06221 75908-0</a> · <a href="mailto:info@city-concepts.de" data-track-pos="footer">info@city-concepts.de</a></p>
        <p class="small">Symbolbilder (KI-generiert)</p>
      </div>
      <nav aria-label="Rechtliches">
        <ul>
          <li><a href="https://city-concepts.de/impressum/">Impressum</a></li>
          <li><a href="https://city-concepts.de/datenschutz/">Datenschutz</a></li>
          <li><a href="/barrierefreiheit/">Barrierefreiheitserklärung</a></li>
        </ul>
      </nav>
    </div>
  </footer>

  <!-- Sticky-CTA (nur Mobile) -->
  <div class="sticky-cta">
    <a class="btn btn--primary" href="#kontakt" data-track-pos="sticky">Erstgespräch anfragen</a>
    <a class="sticky-cta__tel" href="tel:+496221759080" aria-label="Anrufen" data-track-pos="sticky">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
    </a>
  </div>

  <script>
    import '../scripts/form.ts';
    import '../scripts/page.ts';
  </script>
</Base>

<style>
  /* ---------- Gemeinsame Bausteine ---------- */
  main { overflow-x: clip; }
  .h1 { font-size: clamp(2.5rem, 1.5rem + 3.6vw, 4.25rem); line-height: 1.06; font-weight: 500; letter-spacing: -0.03em; }
