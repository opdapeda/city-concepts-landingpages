---
/* Detail-Overlay zu einer Projektreferenz (natives <dialog>, geöffnet über src/scripts/projekte.ts) */
import { Picture } from 'astro:assets';
import type { Projekt } from '../data/projekte';
interface Props { p: Projekt }
const { p } = Astro.props;
const fakten = [{ label: 'Kunde', wert: p.kunde }, ...p.zeitraum.map((z) => ({ label: z.label, wert: z.wert }))];
---
<dialog class="pdlg" id={`projekt-${p.id}`} aria-labelledby={`pt-${p.id}`}>
  <div class="pdlg__panel">
    <button type="button" class="pdlg__close" data-close aria-label="Schließen">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
    </button>

    <div class="pdlg__gal" data-gallery>
      <div class="pdlg__stage">
        {p.bilder.map((b, i) => (
          <figure class="pdlg__slide" hidden={i !== 0} data-slide={i}>
            <Picture src={b.src} alt={b.alt} widths={[480, 800, 1200]} sizes="(min-width: 62rem) 40vw, 92vw" formats={['avif', 'webp']} fallbackFormat={b.src.format === 'png' ? 'png' : 'jpg'} loading="lazy" decoding="async" />
            <figcaption class="pdlg__cap">{b.caption}</figcaption>
          </figure>
        ))}
      </div>
      {p.bilder.length > 1 && (
        <ul class="pdlg__thumbs" aria-label="Bilder des Projekts">
          {p.bilder.map((b, i) => (
            <li>
              <button type="button" data-thumb={i} aria-label={`Bild ${i + 1}: ${b.caption}`} aria-current={i === 0 ? 'true' : undefined}>
                <Picture src={b.src} alt="" widths={[120, 240]} sizes="80px" formats={['webp']} fallbackFormat={b.src.format === 'png' ? 'png' : 'jpg'} loading="lazy" decoding="async" />
              </button>
            </li>
          ))}
        </ul>
      )}
      <dl class="pdlg__facts">
        {fakten.map((f) => (<><dt>{f.label}</dt><dd>{f.wert}</dd></>))}
      </dl>
    </div>

    <div class="pdlg__body">
      <p class="eyebrow">{p.tag} · {p.ort}</p>
      <h2 id={`pt-${p.id}`} class="pdlg__title">{p.titel}</h2>
      <p class="pdlg__sub">{p.untertitel}</p>
      {p.text.map((t) => <p>{t}</p>)}
      <h3 class="pdlg__h">Unsere Leistungen</h3>
      <ul class="pdlg__pills">{p.leistungen.map((l) => <li>{l}</li>)}</ul>
      {p.stimme && (
        <figure class="pdlg__quote">
          <blockquote><p>{p.stimme.zitat}</p></blockquote>
          <figcaption><strong>{p.stimme.wer}</strong>, {p.stimme.rolle}</figcaption>
        </figure>
      )}
      <a class="btn btn--primary pdlg__cta" href="#kontakt" data-close data-track-pos={`projekt-${p.id}`}>Ähnliches Projekt anfragen</a>
    </div>
  </div>
</dialog>

<style is:global>
  html.dlg-lock { overflow: hidden; }
  .pdlg { padding: 0; border: 0; background: var(--c-white); color: var(--c-text); width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh; margin: 0; overflow: hidden; }
  .pdlg::backdrop { background: rgb(31 37 43 / 0.62); }
  .pdlg__panel { position: relative; display: grid; height: 100%; overflow-y: auto; overscroll-behavior: contain; }
  .pdlg__close { position: absolute; z-index: 5; top: 0.75rem; right: 0.75rem; width: 2.75rem; height: 2.75rem; display: grid; place-items: center; border-radius: 50%; border: 2px solid var(--c-ink); background: var(--c-white); color: var(--c-ink); cursor: pointer; padding: 0; }
  .pdlg__close:hover { background: var(--c-ink); color: var(--c-white); }

  .pdlg__gal { background: var(--c-pastel-soft); padding: 1rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .pdlg__slide { margin: 0; }
  .pdlg__slide[hidden] { display: none; }
  .pdlg__slide picture, .pdlg__slide img { display: block; width: 100%; }
  .pdlg__slide img { height: auto; aspect-ratio: 4 / 3; object-fit: contain; background: var(--c-pastel); border-radius: var(--radius-card); }
  .pdlg__cap { margin-top: 0.5rem; font-size: var(--fs-small); color: var(--c-text-muted); }
  .pdlg__thumbs { display: grid; grid-template-columns: repeat(auto-fill, minmax(4.5rem, 1fr)); gap: 0.5rem; }
  .pdlg__thumbs button { display: block; width: 100%; padding: 0; border: 0; border-radius: 0.5rem; overflow: hidden; cursor: pointer; background: var(--c-pastel); opacity: 0.75; }
  .pdlg__thumbs button[aria-current='true'] { opacity: 1; outline: 3px solid var(--c-green); outline-offset: 2px; }
  .pdlg__thumbs img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; }
  .pdlg__facts { margin: 0.25rem 0 0; padding: 0.9rem 1rem; background: var(--c-white); border-radius: 0.875rem; display: grid; grid-template-columns: auto 1fr; gap: 0.35rem 1.25rem; font-size: var(--fs-small); }
  .pdlg__facts dt { color: var(--c-text-muted); }
  .pdlg__facts dd { margin: 0; color: var(--c-ink); font-weight: 500; }

  .pdlg__body { padding: 1.5rem 1.25rem 2rem; display: flex; flex-direction: column; gap: 1rem; align-items: flex-start; }
  .pdlg__body .eyebrow { margin-bottom: 0; padding-right: 3rem; }
  .pdlg__title { font-size: clamp(1.625rem, 1.2rem + 1.4vw, 2.25rem); line-height: 1.15; font-weight: 500; letter-spacing: -0.025em; }
  .pdlg__sub { font-weight: 500; color: var(--c-text-muted); }
  .pdlg__h { font-size: var(--fs-eyebrow); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--c-ink); margin-top: 0.5rem; }
  .pdlg__pills { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .pdlg__pills li { background: var(--c-pastel-soft); color: var(--c-petrol); font-size: var(--fs-small); font-weight: 500; padding: 0.3rem 0.85rem; border-radius: var(--radius-pill); }
  .pdlg__quote { margin: 0.5rem 0 0; border-left: 4px solid var(--c-green); padding-left: 1rem; }
  .pdlg__quote blockquote p { font-size: 1.25rem; line-height: 1.4; color: var(--c-ink); }
  .pdlg__quote figcaption { margin-top: 0.5rem; font-size: var(--fs-small); color: var(--c-text-muted); }
  .pdlg__cta { margin-top: 0.5rem; }

  @media (min-width: 62rem) {
    .pdlg { width: min(68rem, calc(100vw - 4rem)); max-width: none; height: auto; max-height: min(48rem, calc(100dvh - 4rem)); margin: auto; border-radius: var(--radius-panel); box-shadow: var(--shadow-float); }
    .pdlg__panel { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); overflow: hidden; max-height: inherit; }
    .pdlg__gal, .pdlg__body { overflow-y: auto; max-height: min(48rem, calc(100dvh - 4rem)); }
    .pdlg__gal { padding: 1.5rem; }
    .pdlg__body { padding: 2.5rem 2.5rem 2.5rem 2.25rem; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .pdlg[open] { animation: pdlg-in .25s ease; }
    .pdlg[open]::backdrop { animation: pdlg-fade .25s ease; }
  }
  @keyframes pdlg-in { from { opacity: 0; translate: 0 1rem; } }
  @keyframes pdlg-fade { from { opacity: 0; } }
</style>
