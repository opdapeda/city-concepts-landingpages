---
/* Dekoratives Wegeleitungs-Motiv: transparente Winkelformen */
interface Props { class?: string }
---
<svg class:list={['arrows', Astro.props.class]} viewBox="0 0 600 600" aria-hidden="true" focusable="false">
  <g fill="none" stroke="currentColor" stroke-width="56" stroke-linejoin="miter">
    <polyline points="40,80 300,300 40,520" opacity="0.9" />
    <polyline points="240,80 500,300 240,520" opacity="0.55" />
    <polyline points="440,80 700,300 440,520" opacity="0.3" />
  </g>
</svg>
<style>
  .arrows { width: 100%; height: auto; color: var(--c-green); }
</style>
