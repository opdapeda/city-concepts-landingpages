---
/* Bild-Platzhalter. `alt` ist der spätere Alt-Text, `src` der Zielpfad des Originals. */
interface Props { alt: string; src?: string; ratio?: string; class?: string }
const { alt, src, ratio = '4 / 3' } = Astro.props;
---
<div class:list={['ph', Astro.props.class]} role="img" aria-label={alt} style={`aspect-ratio:${ratio}`}>
  <div class="ph__inner" aria-hidden="true">
    <span class="ph__tag">Bild-Platzhalter</span>
    <span class="ph__text">{alt}</span>
    {src && <span class="ph__src">{src}</span>}
  </div>
</div>
<style>
  .ph { width: 100%; background: var(--c-pastel-soft); border: 1px dashed var(--c-text-muted); display: grid; place-items: center; color: var(--c-text); overflow: hidden; }
  .ph__inner { display: flex; flex-direction: column; gap: 0.35rem; padding: 1rem; text-align: center; max-width: 34rem; }
  .ph__tag { font-size: 0.75rem; font-weight: 500; letter-spacing: 0.15em; text-transform: uppercase; color: var(--c-text-muted); }
  .ph__text { font-size: var(--fs-small); line-height: 1.4; }
  .ph__src { font-size: 0.75rem; color: var(--c-text-muted); word-break: break-all; }
</style>
